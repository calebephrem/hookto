{
  "name": "hookto",
  "version": "0.1.0",
  "description": "Self-hostable GitHub App with toggleable feature modules (hooks)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "probot",
    "hookto",
    "self-hosted",
    "modular"
  ],
  "homepage": "https://github.com/hookto/hookto#readme",
  "bugs": {
    "url": "https://github.com/hookto/hookto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hookto/hookto.git"
  },
  "license": "MIT",
  "author": {
    "name": "Hookto",
    "url": "https://github.com/hookto"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "start": "probot run ./dist/index.js",
    "dev": "npm run build && probot run ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "js-yaml": "^5.2.3",
    "picocolors": "^1.1.1",
    "probot": "^14.3.2",
    "unfurl.js": "^6.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "smee-client": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
